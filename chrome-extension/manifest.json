{
  "manifest_version": 3,
  "name": "Radar de Ofertas — Conector 1-Clique",
  "version": "2.0.0",
  "description": "Conexão em 1 clique para sincronização automática de cookies e geração de links meli.la no Radar de Ofertas.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.mercadolivre.com/*",
    "*://mercadolivre.com/*",
    "*://*.meli.la/*",
    "*://meli.la/*",
    "*://painel-de-ofertas.vercel.app/*",
    "*://localhost:*/*",
    "*://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
