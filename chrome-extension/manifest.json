{
  "manifest_version": 3,
  "name": "Radar Conector",
  "version": "2.2.0",
  "description": "Conector oficial do Radar de Ofertas: conecta suas lojas de afiliado com um clique, direto da página da loja.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.mercadolivre.com/*",
    "*://mercadolivre.com/*",
    "https://developers.rakutenadvertising.com/*",
    "https://publisher.rakutenadvertising.com/*",
    "https://associados.amazon.com.br/*",
    "https://affiliate.shopee.com.br/*",
    "*://painel-de-ofertas.vercel.app/*",
    "*://localhost:*/*",
    "*://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
