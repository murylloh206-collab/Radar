# ==============================================================================
# RADAR DE OFERTAS — VARIÁVEIS DE AMBIENTE (MODELO EXEMPLO)
# Copie este arquivo para .env.local e preencha com seus dados reais.
# NUNCA comite ou compartilhe suas chaves e senhas reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL & AUTENTICAÇÃO)
# ------------------------------------------------------------------------------
# URL do seu projeto no Supabase (ex: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima pública para o cliente frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de Serviço com privilégios administrativos (USADA APENAS NO SERVIDOR)
# Obrigatória para sincronização de tabelas e bypass seguro de RLS no backend
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. WHATSAPP (EVOLUTION API)
# ------------------------------------------------------------------------------
# URL base da sua instância da Evolution API (ex: https://evolution.seudominio.com)
EVOLUTION_BASE_URL=

# Nome da instância criada na Evolution API (ex: radar_ofertas)
EVOLUTION_INSTANCE_NAME=radar_ofertas

# Chave de API da sua Evolution API (global ou de instância)
EVOLUTION_API_KEY=

# Token de autenticação para validar as chamadas do webhook recebidas da Evolution API
EVOLUTION_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. SEGURANÇA DO WORKER & DISPARADOR AGENDADO
# ------------------------------------------------------------------------------
# Token secreto para proteger chamadas na rota /api/worker/poll (cron job / cron task)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. AFILIADOS (MERCADO LIVRE, SHOPEE, NETSHOES / RAKUTEN)
# ------------------------------------------------------------------------------
# Mercado Livre: ID da Ferramenta de Afiliado (matt_tool) e Tag de Rastreio (matt_word)
# Estes valores também podem ser configurados diretamente pela tela de Ajustes do painel.
ML_AFFILIATE_APP_ID=
ML_AFFILIATE_TAG=

# Shopee: Sub-ID ou Tracking ID oficial do programa de afiliados
SHOPEE_AFFILIATE_SUB_ID=

# Netshoes / Rakuten LinkShare: Site ID de afiliado da sua conta Rakuten
RAKUTEN_NETSHOES_SITE_ID=
