# =============================================================
#  Painel de Ofertas Afiliadas — configurações de exemplo
#  Copie este arquivo para ".env.local" e ajuste os valores.
#  NUNCA coloque senhas/tokens reais neste arquivo de exemplo.
# =============================================================

# Porta local onde o painel vai rodar (http://localhost:3000)
PORT=3000

# Termos buscados no Mercado Livre, separados por vírgula
SEARCH_TERMS=fone bluetooth,air fryer,notebook gamer

# Quantos produtos trazer por termo (1 a 50)
RESULTS_PER_TERM=12

# Site do Mercado Livre (MLB = Brasil)
ML_SITE_ID=MLB

# -------------------------------------------------------------
#  Credenciais do Mercado Livre (obrigatórias para buscar)
#  A API oficial exige um aplicativo cadastrado (é gratuito):
#  https://developers.mercadolivre.com.br/devcenter
#  Preencha no seu .env.local (não aqui!).
# -------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Opcional: se você já tiver um access token válido, pode colar aqui.
# Ele expira em ~6 horas. Se ficar vazio, o painel gera um sozinho
# usando ML_CLIENT_ID e ML_CLIENT_SECRET.
ML_ACCESS_TOKEN=

# Arquivo onde os dados ficam salvos (relativo à pasta do projeto)
DATA_FILE=data/ofertas.json

# -------------------------------------------------------------
#  FUTURO — Telegram (NÃO é usado nesta versão)
#  Deixe vazio. Nada é publicado automaticamente.
# -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -------------------------------------------------------------
#  Supabase PostgreSQL (Banco Compartilhado & Persistência)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave de segurança para o endpoint do cron
CRON_SECRET=

